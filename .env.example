# --- CFBD API ---
CFBD_API_KEY=your_cfbd_key_here

# --- Warehouse selector: "bigquery" or "snowflake" ---
WAREHOUSE=bigquery

# --- BigQuery (if WAREHOUSE=bigquery) ---
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BIGQUERY_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=cfb_raw

# --- Snowflake (if WAREHOUSE=snowflake) ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CFB_RAW

# --- LLM insight layer (optional) ---
LLM_PROVIDER=groq
LLM_API_KEY=your_llm_api_key_here
